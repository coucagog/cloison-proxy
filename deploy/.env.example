# =============================================================================
# CLOISON STACK-7 — .env.example (développement, hôte wonkom.ai)
#
# Copier vers `.env` à la racine du dépôt (ou du répertoire de déploiement) :
#   cp deploy/.env.example .env && $EDITOR .env
#
# RÈGLE ABSOLUE : AUCUNE valeur réelle ici — uniquement des commentaires et
# des valeurs vides/par défaut. Les secrets (CLOISON_EXPECTED_ACCESS_TOKEN,
# CLOISON_TENANT_KEY_HEX, OPENROUTER_API_KEY, CLOISON_SESSION_SALT_HEX…)
# sont générés localement et ne sont JAMAIS committés.
#
# Référence complète : docs/CONFIG.md (noms, défauts, rôles, secret oui/non).
# =============================================================================

# ─── Edge / proxy (binaire cloison-proxy) ────────────────────────────────────

# Port d'écoute (alternative à CLOISON_LISTEN_ADDR). Défaut : 8787.
# CLOISON_PROXY_PORT=8787

# Adresse d'écoute complète. Défaut : 0.0.0.0:8787.
# CLOISON_LISTEN_ADDR=0.0.0.0:8787

# URL de base du fournisseur LLM. REQUIS hors mock.
#   OpenRouter : https://openrouter.ai/api/v1   (chemins /chat/completions, /models)
#   Style OpenAI : https://openrouter.ai/api    (chemins /v1/chat/completions, /v1/models)
#   DeepSeek   : https://api.deepseek.com       (chemins /chat/completions, /models)
# CLOISON_UPSTREAM_BASE_URL=https://openrouter.ai/api/v1

# Chemins amont (défauts : /v1/chat/completions, /v1/completions, /v1/models —
# à ajuster selon la base : OpenRouter /api/v1 → /chat/completions).
# CLOISON_UPSTREAM_CHAT_PATH=/chat/completions
# CLOISON_UPSTREAM_COMPLETIONS_PATH=/v1/completions
# CLOISON_UPSTREAM_MODELS_PATH=/models

# Timeouts amont (ms). Défauts : 5000 / 30000.
# CLOISON_UPSTREAM_CONNECT_TIMEOUT_MS=5000
# CLOISON_UPSTREAM_TIMEOUT_MS=30000

# Limite de corps entrante (octets). Défaut : 1048576 (1 MiB).
# CLOISON_MAX_BODY_BYTES=1048576

# Flux SSE : taille max d'une sentinelle (défaut 64, plafond 256),
# marqueur neutre fail-loud (défaut [REDACTED]), keep-alive ms (défaut 15000).
# CLOISON_STREAM_MAX_TOKEN_LEN=64
# CLOISON_STREAM_NEUTRAL_MARKER=[REDACTED]
# CLOISON_STREAM_KEEP_ALIVE_MS=15000

# Jeton d'accès local attendu par edge (partie `mn_*` de la clé composite).
# Générer : openssl rand -hex 16 → préfixer par `mn_`.
# CLOISON_EXPECTED_ACCESS_TOKEN=mn_<32 hex>

# Clé locataire 32 octets en hex (64 caractères). REQUIS hors mock.
# Générer : openssl rand -hex 32
# CLOISON_TENANT_KEY_HEX=<64 hex>

# Sel de session 16 octets en hex (32 caractères). Optionnel : aléatoire par
# boot si absent (rotation des jetons entre redémarrages).
# CLOISON_SESSION_SALT_HEX=<32 hex>

# Mode mock (1 = prérequis assouplis, clé de dev) — JAMAIS en production.
# CLOISON_MOCK_MODE=0

# ─── Mode audit (STACK-4, edge) ──────────────────────────────────────────────

# 1 = observe-only : détection + comptage, reçus signés Ed25519, rapport
# k-anonyme. 0 = masquage/restauration actif (e2e réel).
# CLOISON_AUDIT_MODE=1

# Chemin de la clé de signature Ed25519 de l'agent (32 octets bruts ou 64 hex) ;
# générée (0600) au boot si absente.
# CLOISON_AUDIT_KEYS=/data/audit_key

# Seuil k-anonyme du rapport de conformité. Défaut : 5.
# CLOISON_AUDIT_K=5

# Persistance des reçus d'audit (STACK-8) : JSONL append-only 0600, rechargé
# au boot. Défaut compose : /data/audit_ledger.jsonl.
# CLOISON_AUDIT_LEDGER_FILE=/data/audit_ledger.jsonl

# ─── Control (binaire cloison-control — STACK-7/8) ───────────────────────────

# Rôle du binaire (edge|control). Dispatch à implémenter dans config.rs (STACK-7).
# CLOISON_ROLE=control

# Journal de transparence append-only (chaîne de hachage + signatures).
# CLOISON_LEDGER_FILE=/data/ledger.jsonl

# PostgresStore (STACK-8, feature `pg` — image control construite avec).
# Activer le profil `db` du compose + cette URL pour la persistance du plan
# de contrôle (tenants, jetons hachés, politiques, licences). Ex. :
# postgres://cloison:<mdp>@postgres:5432/cloison  (réseau interne compose)
# CLOISON_DATABASE_URL=

# ─── Detect (sidecar Python) ──────────────────────────────────────────────────

# Transport : rest | grpc | both (défaut rest ; nominal production = grpc).
# CLOISON_TRANSPORT=both
# CLOISON_REST_PORT=8080
# CLOISON_GRPC_PORT=50051
# CLOISON_OFFLINE=0            # 1 = aucun téléchargement réseau
# CLOISON_PRELOAD=all          # none | auto | all (STACK-8 : précharger les modèles au boot)
# CLOISON_SPACY_SIZE=md        # sm | md | lg (STACK-8 : md par défaut — fr_sm hallucine)
# CLOISON_MODEL_CACHE_GB=6.0
# CLOISON_MODEL_DIR=/models
# HF_HOME=/models              # cache Hugging Face dans le volume (GLiNER, afroxlmr)
# HF_HUB_OFFLINE=0             # 1 = aucun accès réseau HF (modèles pré-chargés)
# CLOISON_BUDGET_SECONDS=2.0   # deadline douce par requête
# CLOISON_QUARANTINE_SECONDS=300.0
# CLOISON_SESSION_MENTIONS_MAX=200
# CLOISON_ONNX=0
# CLOISON_LOG_LEVEL=INFO

# Image detect : CLOISON_LITE=0 (défaut STACK-8, GLiNER+torch inclus — le
# fossé GO repose sur afroxlmr) ; 1 = image légère sans NER transformer.
# Modèle spaCy de l'oracle : SPACY_MODEL=fr_core_news_md (défaut STACK-8).
# CLOISON_LITE=0
# SPACY_MODEL=fr_core_news_md

# ─── Clé LLM réelle (fournisseur) — SECRET, jamais committé ──────────────────

# Clé du fournisseur (OpenRouter : sk-or-v1-…). Utilisée en clé composite
# `Authorization: Bearer mn_<access>.<upstream_key>` : la partie amont est
# réinjectée telle quelle chez le fournisseur, jamais en URL/log.
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx

# ─── Divers / optionnels ──────────────────────────────────────────────────────

# Journal structuré Rust (crate = cloison_proxy).
# RUST_LOG=cloison_proxy=info

# Mot de passe du miroir postgres (profil `db`, dev uniquement).
# CLOISON_PG_PASSWORD=cloison-dev-only

# Wiring edge -> detect (B.1 — lu par le binaire) : URL REST du sidecar NER.
# Dégradation gracieuse : sidecar indisponible → détection embarquée seule.
# CLOISON_DETECT_URL=http://detect:8080/detect
# CLOISON_DETECT_TIMEOUT_MS=2000
